PORT=3001
DATABASE_URL=postgresql://username:password@localhost:5432/xean_intake
ANTHROPIC_API_KEY=your-api-key-here
RESEND_API_KEY=your-resend-api-key-here
# Used to build links back into the app from notification emails —
# update this to the real deployed URL once there is one.
APP_BASE_URL=http://localhost:5173
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
# Generate your own with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-secret
# Leave unset for local dev. Set to the deployed frontend's origin(s) —
# comma-separated if there's more than one — only when the frontend is
# hosted on a different origin than this API (e.g. Vercel calling Railway).
# CORS_ORIGIN=https://www.xean.ca,https://xean.ca
