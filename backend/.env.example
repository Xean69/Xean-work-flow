PORT=3001
DATABASE_URL=postgresql://username:password@localhost:5432/xean_intake
ANTHROPIC_API_KEY=your-api-key-here
RESEND_API_KEY=your-resend-api-key-here
# Used to build links back into the app from notification emails —
# update this to the real deployed URL once there is one.
APP_BASE_URL=http://localhost:5173
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
# Websites Phase 2 (<subdomain>.xean.ca) — a token from vercel.com/account/tokens
# scoped to the frontend's Vercel project, plus that project's ID. Only set
# VERCEL_TEAM_ID if the Vercel project lives under a Team, not a persona     l account.
VERCEL_API_TOKEN=your-vercel-api-token
VERCEL_PROJECT_ID=your-vercel-project-id
# VERCEL_TEAM_ID=your-vercel-team-id
# Generate your own with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-secret
# Encrypts admin 2FA (TOTP) secrets at rest -- must be a 64-character hex
# string (32 bytes) for AES-256. Generate with the same command as above.
# Changing this after any admin has 2FA enabled breaks their ability to log
# in (the stored secret can no longer be decrypted) -- treat it like a
# database credential, not something to rotate casually.
TOTP_ENCRYPTION_KEY=replace-with-a-random-64-char-hex-string
# Leave unset for local dev. Set to the deployed frontend's origin(s) —
# comma-separated if there's more than one — only when the frontend is
# hosted on a different origin than this API (e.g. Vercel calling Railway).
# CORS_ORIGIN=https://www.xean.ca,https://xean.ca
